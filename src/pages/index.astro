---
import BaseLayout from '../layouts/BaseLayout.astro';
import { vi, tools, products, whyItems } from '../data/homepage';
---
<BaseLayout title="BRIDGE — Khiến AI Làm Việc Cho Bạn" description={vi.subtitle}>

  <!-- Hero -->
  <section style="padding:5rem 0 3rem;text-align:center;">
    <div class="container">
      <div class="badge" style="margin-bottom:1.5rem;">{vi.badge}</div>
      <h1 style="margin-bottom:1rem;">
        {vi.title} <span class="gradient-text">{vi.titleAccent}</span>
      </h1>
      <p style="font-size:1.125rem;max-width:600px;margin-inline:auto;margin-bottom:2rem;line-height:1.75;">
        {vi.subtitle}
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/compass/" class="btn btn-primary">{vi.ctaPrimary}</a>
        <a href="#products" class="btn btn-secondary">{vi.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding:2rem 0 3rem;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:700px;margin-inline:auto;">
        <div class="card" style="text-align:center;">
          <div class="stat-value" style="color:var(--color-accent-green);">{vi.stat1Value}</div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">{vi.stat1Label}</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-value" style="color:var(--color-accent-2);">{vi.stat2Value}</div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">{vi.stat2Label}</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-value" style="color:var(--color-accent);">{vi.stat3Value}</div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">{vi.stat3Label}</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Compass Tools -->
  <section style="padding:3.5rem 0;">
    <div class="container">
      <h2 style="text-align:center;margin-bottom:0.5rem;">{vi.compassTitle}</h2>
      <p style="text-align:center;font-size:0.9375rem;max-width:480px;margin-inline:auto;margin-bottom:2.5rem;">
        {vi.compassSubtitle}
      </p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;max-width:900px;margin-inline:auto;">
        {tools.map(t => (
          <a href={t.href} class="card card-link" style="text-align:center;">
            <div class="tool-icon">{t.icon}</div>
            <div class="tool-name">{t.name}</div>
            <div class="tool-desc">{t.desc}</div>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:1.5rem;">
        <a href="/compass/" style="color:var(--color-accent);font-weight:600;font-size:0.9rem;">{vi.compassLinkAll}</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Products -->
  <section id="products" style="padding:3.5rem 0;">
    <div class="container">
      <h2 style="text-align:center;margin-bottom:0.5rem;">{vi.productsTitle}</h2>
      <p style="text-align:center;font-size:0.9375rem;max-width:480px;margin-inline:auto;margin-bottom:2.5rem;">
        {vi.productsSubtitle}
      </p>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:900px;margin-inline:auto;">
        {products.map(p => (
          <div class="card" style="display:flex;flex-direction:column;">
            <div style="font-size:1.75rem;margin-bottom:0.75rem;">{p.icon}</div>
            <div style="font-weight:700;font-size:1rem;margin-bottom:0.5rem;">{p.name}</div>
            <div style="font-size:0.875rem;color:var(--color-text-muted);flex:1;margin-bottom:1rem;">{p.desc}</div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.8125rem;">
              <span style="color:var(--color-text-muted);">{p.price}</span>
              <span class={p.live ? 'status-live' : 'status-coming'} style="font-weight:600;">
                {p.live ? '🟢' : '🟡'} {p.status}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Why BRIDGE -->
  <section style="padding:3.5rem 0;">
    <div class="container">
      <h2 style="text-align:center;margin-bottom:2.5rem;">{vi.whyTitle}</h2>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;max-width:800px;margin-inline:auto;">
        {whyItems.map(w => (
          <div class="card">
            <div style="font-size:1.5rem;margin-bottom:0.5rem;">{w.icon}</div>
            <div style="font-weight:700;margin-bottom:0.375rem;">{w.title}</div>
            <div style="font-size:0.875rem;color:var(--color-text-muted);">{w.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <section style="padding:4rem 0 5rem;">
    <div class="container" style="text-align:center;max-width:580px;">
      <div class="card" style="padding:3rem;background:linear-gradient(145deg,rgba(245,158,11,0.08),rgba(129,140,248,0.05));">
        <h2 style="margin-bottom:0.75rem;">{vi.ctaBoxTitle}</h2>
        <p style="margin-bottom:2rem;">{vi.ctaBoxSubtitle}</p>
        <a href="/compass/quick/" class="btn btn-primary">{vi.ctaBoxBtn}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  @media (max-width: 640px) {
    [style*="grid-template-columns:repeat(4"] { grid-template-columns: repeat(2,1fr) !important; }
    [style*="grid-template-columns:repeat(3"] { grid-template-columns: 1fr !important; }
    [style*="grid-template-columns:repeat(2"] { grid-template-columns: 1fr !important; }
  }
</style>
