---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Máy Tính Chi Phí AI | BRIDGE" description="Tính ngân sách AI thực tế cho doanh nghiệp hoặc cá nhân của bạn.">

  <section style="padding:4rem 0 2rem;text-align:center;">
    <div class="container" style="max-width:720px;">
      <div class="badge" style="margin-bottom:1.25rem;">🧮 Máy Tính Chi Phí · 2 phút</div>
      <h1 style="margin-bottom:0.75rem;">Ngân Sách AI <span class="gradient-text">Của Bạn</span></h1>
      <p style="font-size:1.0625rem;max-width:560px;margin-inline:auto;">
        Tính tổng chi phí AI thực tế — từ subscription đến API token.
      </p>
    </div>
  </section>

  <section style="padding:1rem 0 5rem;">
    <div class="container" style="max-width:640px;">
      <div class="card" style="padding:2rem;">
        <h3 style="margin-bottom:1.25rem;">Chọn Công Cụ Bạn Dùng</h3>

        <div id="toolList"></div>

        <div style="height:1px;background:var(--color-border);margin:1.5rem 0;"></div>

        <h3 style="margin-bottom:1rem;">Thêm Chi Phí Tùy Chỉnh</h3>
        <div style="display:flex;gap:0.75rem;margin-bottom:1.25rem;">
          <input id="customName" class="form-input" placeholder="Tên công cụ" style="flex:2;" />
          <input id="customCost" type="number" class="form-input" placeholder="$/tháng" style="flex:1;" min="0" />
          <button onclick="addCustom()" class="btn btn-secondary" style="flex-shrink:0;">+ Thêm</button>
        </div>
        <div id="customItems"></div>

        <div style="background:var(--color-bg-elevated);border-radius:var(--radius-md);padding:1.25rem;margin-top:1rem;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
            <span style="font-weight:600;">Tổng/tháng</span>
            <span id="totalMonthly" style="font-size:1.5rem;font-weight:900;color:var(--color-accent);">$0</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
            <span style="font-size:0.875rem;color:var(--color-text-muted);">Tổng/năm</span>
            <span id="totalYearly" style="font-weight:700;color:var(--color-text-secondary);">$0</span>
          </div>
          <div id="budgetNote" style="font-size:0.8rem;margin-top:0.75rem;padding:0.625rem;border-radius:var(--radius-sm);"></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  .form-group { margin-bottom:1.25rem; }
  .form-label { display:block; font-size:0.875rem; font-weight:600; margin-bottom:0.5rem; color:var(--color-text-secondary); }
  .form-input {
    width:100%; padding:0.75rem 1rem;
    background:var(--color-bg-elevated); border:1px solid var(--color-border);
    border-radius:var(--radius-md); color:var(--color-text-primary);
    font-size:1rem; outline:none; transition:border-color 0.15s;
    box-sizing:border-box;
  }
  .form-input:focus { border-color:var(--color-accent); }
  .tool-row { display:flex; align-items:center; gap:0.75rem; padding:0.75rem 0; border-bottom:1px solid var(--color-border); }
  .tool-row:last-child { border-bottom:none; }
  .tool-check { width:1.25rem; height:1.25rem; cursor:pointer; accent-color:var(--color-accent); }
</style>

<script>
  const TOOLS = [
    { name:'ChatGPT Plus',   cost:20 },
    { name:'Claude Pro',     cost:20 },
    { name:'Gemini Advanced',cost:20 },
    { name:'Midjourney',     cost:10 },
    { name:'Perplexity Pro', cost:20 },
    { name:'ElevenLabs',     cost:5  },
    { name:'Notion AI',      cost:10 },
    { name:'Zapier Starter', cost:20 },
    { name:'Runway Gen-2',   cost:12 },
    { name:'HeyGen Starter', cost:29 },
  ];

  let checked = {}, customs = [];

  function renderTools() {
    document.getElementById('toolList').innerHTML = TOOLS.map((t,i) => `
      <div class="tool-row">
        <input type="checkbox" class="tool-check" id="t${i}" onchange="toggle(${i})" ${checked[i]?'checked':''} />
        <label for="t${i}" style="flex:1;cursor:pointer;">${t.name}</label>
        <span style="font-size:0.875rem;color:var(--color-text-muted);">$${t.cost}/tháng</span>
      </div>`).join('');
  }

  window.toggle = function(i) {
    checked[i] = !checked[i];
    updateTotal();
  };

  window.addCustom = function() {
    const name = document.getElementById('customName').value.trim();
    const cost = parseFloat(document.getElementById('customCost').value) || 0;
    if (!name || cost <= 0) return;
    customs.push({ name, cost });
    document.getElementById('customName').value = '';
    document.getElementById('customCost').value = '';
    renderCustoms();
    updateTotal();
  };

  function renderCustoms() {
    document.getElementById('customItems').innerHTML = customs.map((c,i) => `
      <div class="tool-row">
        <span style="flex:1;">${c.name}</span>
        <span style="font-size:0.875rem;color:var(--color-text-muted);">$${c.cost}/tháng</span>
        <button onclick="removeCustom(${i})" style="background:none;border:none;color:var(--color-text-muted);cursor:pointer;font-size:1.1rem;">×</button>
      </div>`).join('');
  }

  window.removeCustom = function(i) {
    customs.splice(i, 1);
    renderCustoms();
    updateTotal();
  };

  function updateTotal() {
    let total = customs.reduce((s,c)=>s+c.cost, 0);
    TOOLS.forEach((t,i) => { if (checked[i]) total += t.cost; });
    document.getElementById('totalMonthly').textContent = '$' + total;
    document.getElementById('totalYearly').textContent = '$' + (total * 12);
    const note = document.getElementById('budgetNote');
    if (total === 0) {
      note.style.display = 'none';
    } else if (total <= 50) {
      note.style.cssText += ';background:rgba(52,211,153,0.1);color:var(--color-accent-green);display:block;';
      note.textContent = '✅ Ngân sách tốt cho cá nhân — tiếp tục thêm khi thấy ROI rõ ràng.';
    } else if (total <= 150) {
      note.style.cssText += ';background:rgba(245,158,11,0.1);color:var(--color-accent);display:block;';
      note.textContent = '⚡ Ngân sách chuẩn cho small team. Theo dõi ROI hàng tháng.';
    } else {
      note.style.cssText += ';background:rgba(129,140,248,0.1);color:var(--color-accent-2);display:block;';
      note.textContent = '🚀 Ngân sách enterprise. Đảm bảo mỗi tool đang được dùng tối đa.';
    }
  }

  renderTools();
  updateTotal();
</script>
