---
import BaseLayout from '../../layouts/BaseLayout.astro';

const processes = [
  { id:'email',      emoji:'📧', name:'Trả lời email',         hours:3,  difficulty:'Dễ',   tool:'ChatGPT / Gemini' },
  { id:'report',     emoji:'📊', name:'Viết báo cáo tuần',    hours:2,  difficulty:'Dễ',   tool:'ChatGPT / Notion AI' },
  { id:'content',    emoji:'📱', name:'Tạo social content',    hours:4,  difficulty:'Dễ',   tool:'ContentBridge' },
  { id:'research',   emoji:'🔍', name:'Nghiên cứu thị trường', hours:5,  difficulty:'Trung', tool:'Perplexity / Claude' },
  { id:'meeting',    emoji:'📝', name:'Tóm tắt cuộc họp',      hours:1,  difficulty:'Dễ',   tool:'Otter.ai / Gemini' },
  { id:'invoice',    emoji:'🧾', name:'Xử lý hóa đơn',        hours:2,  difficulty:'Trung', tool:'Zapier / Make.com' },
  { id:'support',    emoji:'💬', name:'Chăm sóc khách hàng',   hours:6,  difficulty:'Trung', tool:'Chatbot + ChatGPT' },
  { id:'scheduling', emoji:'📅', name:'Lên lịch & nhắc nhở',   hours:1,  difficulty:'Dễ',   tool:'Cal.ai / Motion' },
];
---
<BaseLayout title="Tự Động Hóa — Tìm Quy Trình Lãng Phí Thời Gian | BRIDGE" description="Xác định những quy trình nào trong công việc của bạn có thể tự động hóa bằng AI.">

  <section style="padding:4rem 0 2rem;text-align:center;">
    <div class="container" style="max-width:720px;">
      <div class="badge" style="margin-bottom:1.25rem;">⚡ Tự Động Hóa · 3 phút</div>
      <h1 style="margin-bottom:0.75rem;">Quy Trình Nào <span class="gradient-text">Tốn Thời Gian Nhất?</span></h1>
      <p style="font-size:1.0625rem;max-width:560px;margin-inline:auto;">
        Chọn những việc bạn đang làm thủ công — xem AI có thể giúp ở đâu và tiết kiệm bao nhiêu.
      </p>
    </div>
  </section>

  <section style="padding:1rem 0 5rem;">
    <div class="container" style="max-width:840px;">
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-bottom:2rem;">
        {processes.map(p => (
          <div class="card auto-card" data-hours={p.hours} data-id={p.id} onclick="toggleCard(this)" style="cursor:pointer;">
            <div style="display:flex;align-items:flex-start;gap:0.75rem;">
              <span style="font-size:1.5rem;">{p.emoji}</span>
              <div style="flex:1;">
                <div style="font-weight:700;margin-bottom:0.25rem;">{p.name}</div>
                <div style="font-size:0.8rem;color:var(--color-text-muted);">~{p.hours}h/tuần · {p.difficulty}</div>
                <div style="font-size:0.8rem;color:var(--color-accent);margin-top:0.25rem;">Tool: {p.tool}</div>
              </div>
              <div class="check-icon" style="width:1.375rem;height:1.375rem;border:2px solid var(--color-border);border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:0.7rem;transition:all 0.15s;"></div>
            </div>
          </div>
        ))}
      </div>

      <div class="card" id="summary" style="padding:1.75rem;display:none;">
        <h3 style="margin-bottom:1rem;">Kết Quả Phân Tích</h3>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.25rem;">
          <div style="text-align:center;padding:1rem;background:var(--color-bg-elevated);border-radius:var(--radius-md);">
            <div id="countSelected" style="font-size:1.75rem;font-weight:900;color:var(--color-accent);">0</div>
            <div style="font-size:0.75rem;color:var(--color-text-muted);">Quy trình có thể tự động</div>
          </div>
          <div style="text-align:center;padding:1rem;background:var(--color-bg-elevated);border-radius:var(--radius-md);">
            <div id="hoursSaved" style="font-size:1.75rem;font-weight:900;color:var(--color-accent-green);">0h</div>
            <div style="font-size:0.75rem;color:var(--color-text-muted);">Tiết kiệm/tuần</div>
          </div>
          <div style="text-align:center;padding:1rem;background:var(--color-bg-elevated);border-radius:var(--radius-md);">
            <div id="yearSaved" style="font-size:1.75rem;font-weight:900;color:var(--color-accent-2);">0h</div>
            <div style="font-size:0.75rem;color:var(--color-text-muted);">Tiết kiệm/năm</div>
          </div>
        </div>
        <a href="/compass/quick/" class="btn btn-primary" style="width:100%;justify-content:center;">🧭 Tìm AI Phù Hợp →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  .auto-card { transition:border-color 0.15s, background 0.15s; }
  .auto-card.selected { border-color:var(--color-accent); background:rgba(245,158,11,0.06); }
  .auto-card.selected .check-icon { background:var(--color-accent); border-color:var(--color-accent); color:#000; }
  .auto-card.selected .check-icon::after { content:'✓'; }
  @media (max-width:640px) {
    [style*="grid-template-columns:repeat(2"] { grid-template-columns:1fr !important; }
  }
</style>

<script>
  let selected = new Set();

  window.toggleCard = function(el) {
    const id = el.dataset.id;
    const hours = parseFloat(el.dataset.hours) || 0;
    if (selected.has(id)) {
      selected.delete(id);
      el.classList.remove('selected');
    } else {
      selected.add(id);
      el.classList.add('selected');
    }
    updateSummary();
  };

  function updateSummary() {
    const summary = document.getElementById('summary');
    if (selected.size === 0) { summary.style.display = 'none'; return; }
    summary.style.display = 'block';

    let totalHours = 0;
    selected.forEach(id => {
      const card = document.querySelector(`[data-id="${id}"]`);
      if (card) totalHours += parseFloat(card.dataset.hours) || 0;
    });
    const saved = Math.round(totalHours * 0.6);
    document.getElementById('countSelected').textContent = selected.size;
    document.getElementById('hoursSaved').textContent = saved + 'h';
    document.getElementById('yearSaved').textContent = (saved * 52) + 'h';
    summary.scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
</script>
