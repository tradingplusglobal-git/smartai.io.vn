---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Báo Cáo AI — Tổng Hợp Kết Quả | BRIDGE" description="Xem tổng hợp kết quả từ tất cả công cụ Compass của bạn.">

  <section style="padding:4rem 0 2rem;text-align:center;">
    <div class="container" style="max-width:720px;">
      <div class="badge" style="margin-bottom:1.25rem;">📊 Báo Cáo AI · 1 phút</div>
      <h1 style="margin-bottom:0.75rem;">Tổng Hợp <span class="gradient-text">Kết Quả Của Bạn</span></h1>
      <p style="font-size:1.0625rem;max-width:560px;margin-inline:auto;">
        Xem lại tất cả kết quả từ các công cụ Compass và bước tiếp theo.
      </p>
    </div>
  </section>

  <section style="padding:1rem 0 5rem;">
    <div class="container" style="max-width:700px;">

      <!-- Summary cards -->
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-bottom:1.5rem;">
        <div class="card" style="text-align:center;">
          <div style="font-size:2rem;margin-bottom:0.25rem;">🧭</div>
          <div style="font-weight:700;margin-bottom:0.25rem;">Compass Nhanh</div>
          <div id="quickStatus" style="font-size:0.8125rem;color:var(--color-text-muted);">Chưa hoàn thành</div>
          <a href="/compass/quick/" style="font-size:0.8rem;color:var(--color-accent);margin-top:0.5rem;display:block;">→ Bắt đầu</a>
        </div>
        <div class="card" style="text-align:center;">
          <div style="font-size:2rem;margin-bottom:0.25rem;">📈</div>
          <div style="font-weight:700;margin-bottom:0.25rem;">Tính ROI</div>
          <div id="roiStatus" style="font-size:0.8125rem;color:var(--color-text-muted);">Chưa hoàn thành</div>
          <a href="/compass/roi/" style="font-size:0.8rem;color:var(--color-accent);margin-top:0.5rem;display:block;">→ Tính ngay</a>
        </div>
        <div class="card" style="text-align:center;">
          <div style="font-size:2rem;margin-bottom:0.25rem;">🎯</div>
          <div style="font-weight:700;margin-bottom:0.25rem;">Đánh Giá Sẵn Sàng</div>
          <div id="readinessStatus" style="font-size:0.8125rem;color:var(--color-text-muted);">Chưa hoàn thành</div>
          <a href="/compass/readiness/" style="font-size:0.8rem;color:var(--color-accent);margin-top:0.5rem;display:block;">→ Đánh giá</a>
        </div>
        <div class="card" style="text-align:center;">
          <div style="font-size:2rem;margin-bottom:0.25rem;">⚡</div>
          <div style="font-weight:700;margin-bottom:0.25rem;">Tự Động Hóa</div>
          <div id:'autoStatus' style="font-size:0.8125rem;color:var(--color-text-muted);">Chưa hoàn thành</div>
          <a href="/compass/automator/" style="font-size:0.8rem;color:var(--color-accent);margin-top:0.5rem;display:block;">→ Khám phá</a>
        </div>
      </div>

      <!-- Next step CTA -->
      <div class="card" style="padding:2rem;text-align:center;background:linear-gradient(145deg,rgba(245,158,11,0.08),rgba(129,140,248,0.05));">
        <h3 style="margin-bottom:0.5rem;">Bắt Đầu Hành Trình AI</h3>
        <p style="font-size:0.9375rem;margin-bottom:1.5rem;">Dùng Compass Nhanh để nhận đề xuất AI cá nhân hóa chỉ trong 60 giây.</p>
        <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
          <a href="/compass/quick/" class="btn btn-primary">🧭 Compass Nhanh</a>
          <a href="/" class="btn btn-secondary">Xem Sản Phẩm →</a>
        </div>
      </div>

      <!-- All tools -->
      <div style="margin-top:2rem;">
        <h3 style="margin-bottom:1rem;text-align:center;font-size:1rem;color:var(--color-text-muted);">Tất Cả Công Cụ</h3>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.75rem;">
          {[
            { href:'/compass/quick/',      icon:'🧭', name:'Compass Nhanh' },
            { href:'/compass/roi/',        icon:'📈', name:'Tính ROI' },
            { href:'/compass/readiness/',  icon:'🎯', name:'Sẵn Sàng AI' },
            { href:'/compass/navigation/', icon:'🗺️', name:'Bản Đồ AI' },
            { href:'/compass/matcher/',    icon:'🔍', name:'Tìm Tool AI' },
            { href:'/compass/calculator/', icon:'🧮', name:'Chi Phí AI' },
            { href:'/compass/automator/',  icon:'⚡', name:'Tự Động Hóa' },
            { href:'/compass/report/',     icon:'📊', name:'Báo Cáo' },
          ].map(t => (
            <a href={t.href} class="card" style="text-align:center;padding:0.875rem;">
              <div style="font-size:1.375rem;margin-bottom:0.375rem;">{t.icon}</div>
              <div style="font-size:0.75rem;font-weight:600;">{t.name}</div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style is:global>
  @media (max-width:640px) {
    [style*="grid-template-columns:repeat(2"] { grid-template-columns:1fr !important; }
    [style*="grid-template-columns:repeat(4"] { grid-template-columns:repeat(2,1fr) !important; }
  }
</style>
