---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bản Đồ AI — Lộ Trình 90 Ngày | BRIDGE" description="Nhận lộ trình AI cá nhân hóa 90 ngày dựa trên vai trò và mức độ hiện tại của bạn.">

  <section style="padding:4rem 0 2rem;text-align:center;">
    <div class="container" style="max-width:720px;">
      <div class="badge" style="margin-bottom:1.25rem;">🗺️ Bản Đồ AI · 3 phút</div>
      <h1 style="margin-bottom:0.75rem;">Lộ Trình AI <span class="gradient-text">Của Bạn</span></h1>
      <p style="font-size:1.0625rem;max-width:560px;margin-inline:auto;">
        Chọn vai trò và mức độ để nhận lộ trình AI 90 ngày cá nhân hóa.
      </p>
    </div>
  </section>

  <section style="padding:1rem 0 5rem;">
    <div class="container" style="max-width:680px;">
      <div class="card" style="padding:2rem;" id="navCard">

        <div class="form-group">
          <label class="form-label">Vai trò chính của bạn</label>
          <select id="role" class="form-input">
            <option value="creator">Content Creator / Freelancer</option>
            <option value="marketer">Marketer / Growth</option>
            <option value="founder">Founder / Solopreneur</option>
            <option value="manager">Manager / Team Lead</option>
            <option value="developer">Developer / Tech</option>
            <option value="educator">Educator / Trainer</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Mức độ AI hiện tại</label>
          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.75rem;">
            {['🌱 Mới bắt đầu','🌿 Đã thử qua','🌳 Dùng thường xuyên','🚀 Power user'].map((l,i) => (
              <div class="ai-level-card" id={`lvl${i}`} onclick={`selectLvl(${i})`} style="text-align:center;padding:0.875rem;">
                <div style="font-size:0.9rem;font-weight:600;">{l}</div>
              </div>
            ))}
          </div>
        </div>

        <button onclick="showRoadmap()" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem;">
          🗺️ Xem Lộ Trình Của Tôi →
        </button>

        <div id="roadmapResult" style="display:none;margin-top:2rem;">
          <div style="height:1px;background:var(--color-border);margin-bottom:1.5rem;"></div>
          <div id="roadmapContent"></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  let selectedLevel = -1;

  window.selectLvl = function(i) {
    selectedLevel = i;
    for (let j = 0; j < 4; j++) {
      const el = document.getElementById('lvl'+j);
      if (el) el.className = 'ai-level-card' + (j===i?' selected':'');
    }
  };

  const roadmaps = {
    creator: [
      { phase:'Tháng 1 — Nền Tảng', tasks:['Dùng ChatGPT/Gemini cho mọi draft đầu tiên','Xây prompt template cho content thường xuyên','Thử 1 tool AI chuyên biệt (Midjourney, ElevenLabs)'] },
      { phase:'Tháng 2 — Quy Trình', tasks:['Xây content calendar bằng AI','Tạo brand voice document','Batch content 1 tuần chỉ trong 2 tiếng'] },
      { phase:'Tháng 3 — Scale', tasks:['Repurpose 1 content → 5 nền tảng tự động','Phân tích analytics bằng AI','Thử ContentBridge để có hệ thống bền vững'] },
    ],
    marketer: [
      { phase:'Tháng 1 — Copy & Research', tasks:['AI cho mọi ad copy và email','Nghiên cứu competitor bằng AI','Tóm tắt customer feedback tự động'] },
      { phase:'Tháng 2 — Campaign', tasks:['A/B test copy nhanh hơn với AI','Personalize email sequences','Build chatbot FAQ cơ bản'] },
      { phase:'Tháng 3 — Data & Scale', tasks:['AI phân tích campaign performance','Tự động báo cáo tuần','Scale team với AI skills'] },
    ],
    founder: [
      { phase:'Tháng 1 — Ops Nhanh', tasks:['AI cho mọi email và proposal','Meeting notes và action items tự động','Nghiên cứu thị trường và competitor'] },
      { phase:'Tháng 2 — Team AI', tasks:['Train team dùng AI cơ bản','Xây SOPs với AI assistance','Tự động hóa báo cáo tuần'] },
      { phase:'Tháng 3 — Growth', tasks:['AI funnel từ lead đến close','Content marketing tự động','Evaluate full AI stack budget'] },
    ],
  };

  window.showRoadmap = function() {
    if (selectedLevel < 0) { alert('Vui lòng chọn mức độ AI của bạn'); return; }
    const role = document.getElementById('role').value;
    const map = roadmaps[role] || roadmaps.creator;
    const levelNames = ['Mới bắt đầu','Đã thử qua','Dùng thường xuyên','Power user'];

    document.getElementById('roadmapContent').innerHTML = `
      <h3 style="margin-bottom:0.25rem;">Lộ Trình 90 Ngày Của Bạn</h3>
      <p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:1.5rem;">Vai trò: <strong>${document.getElementById('role').options[document.getElementById('role').selectedIndex].text}</strong> · Mức độ: <strong>${levelNames[selectedLevel]}</strong></p>
      ${map.map((phase, i) => `
        <div style="margin-bottom:1.25rem;padding:1rem;background:var(--color-bg-elevated);border-radius:var(--radius-md);border-left:3px solid var(--color-accent);">
          <div style="font-weight:700;margin-bottom:0.75rem;">${phase.phase}</div>
          ${phase.tasks.map(t => `<div style="font-size:0.875rem;color:var(--color-text-secondary);margin-bottom:0.375rem;">✓ ${t}</div>`).join('')}
        </div>`).join('')}
      <a href="/compass/quick/" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem;">🧭 Tìm AI Phù Hợp Ngay →</a>`;
    document.getElementById('roadmapResult').style.display = 'block';
    document.getElementById('roadmapResult').scrollIntoView({ behavior:'smooth', block:'nearest' });
  };
</script>
