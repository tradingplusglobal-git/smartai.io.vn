---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout 
  title="BRIDGE — AI Platform for Vietnamese Businesses" 
  description="From free assessment tools to premium AI solutions — BRIDGE helps businesses leverage AI the right way."
  lang="en"
>

  <!-- Hero -->
  <section style="padding:5rem 0 3rem;text-align:center;">
    <div class="container">
      <div class="badge" style="margin-bottom:1.5rem;">⚡ AI Platform for Business</div>
      <h1 style="margin-bottom:1rem;">
        Make AI <span class="gradient-text">Work For You</span>
      </h1>
      <p style="font-size:1.125rem;max-width:580px;margin-inline:auto;margin-bottom:2rem;">
        From free assessment tools to premium AI skills — BRIDGE helps you leverage AI the right way, at the right time, within your budget.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/compass/" class="btn btn-primary">🧭 Try Compass Free</a>
        <a href="/#products" class="btn btn-secondary">Our Products →</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding:2rem 0 3rem;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:700px;margin-inline:auto;">
        <div class="card" style="text-align:center;">
          <div class="stat-value" style="color:var(--color-accent-green);">8+</div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">Free Tools</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-value" style="color:var(--color-accent-2);">25+</div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">AI Skills</div>
        </div>
        <div class="card" style="text-align:center;">
          <div class="stat-value" style="color:var(--color-accent);">10–15h</div>
          <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">Saved / Week</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Products -->
  <section style="padding:3.5rem 0 5rem;">
    <div class="container">
      <h2 style="text-align:center;margin-bottom:2.5rem;">BRIDGE Products</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:900px;margin-inline:auto;">
        <div class="card" style="display:flex;flex-direction:column;">
          <div style="font-size:1.75rem;margin-bottom:0.75rem;">✍️</div>
          <div style="font-weight:700;margin-bottom:0.5rem;">ContentBridge</div>
          <div style="font-size:0.875rem;color:var(--color-text-muted);flex:1;margin-bottom:1rem;">AI content skills suite. 25 variants for Creator, Affiliate, Email, Agency, Business.</div>
          <div style="display:flex;justify-content:space-between;font-size:0.8125rem;">
            <span style="color:var(--color-text-muted);">From $19/mo</span>
            <span class="status-live" style="font-weight:600;">🟢 Live</span>
          </div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;">
          <div style="font-size:1.75rem;margin-bottom:0.75rem;">🎬</div>
          <div style="font-weight:700;margin-bottom:0.5rem;">CreatorStudio</div>
          <div style="font-size:0.875rem;color:var(--color-text-muted);flex:1;margin-bottom:1rem;">AI video production pipeline. Scripts, thumbnails, SEO, multi-channel distribution.</div>
          <div style="display:flex;justify-content:space-between;font-size:0.8125rem;">
            <span style="color:var(--color-text-muted);">Coming soon</span>
            <span class="status-coming" style="font-weight:600;">🟡 In Development</span>
          </div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;">
          <div style="font-size:1.75rem;margin-bottom:0.75rem;">📄</div>
          <div style="font-weight:700;margin-bottom:0.5rem;">DocBridge</div>
          <div style="font-size:0.875rem;color:var(--color-text-muted);flex:1;margin-bottom:1rem;">AI business document processing. Contracts, reports, proposals.</div>
          <div style="display:flex;justify-content:space-between;font-size:0.8125rem;">
            <span style="color:var(--color-text-muted);">Coming soon</span>
            <span class="status-coming" style="font-weight:600;">🟡 In Development</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
